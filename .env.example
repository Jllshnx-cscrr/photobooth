# Photo Booth Configuration
# Copy this file to .env for local configuration

# Development server port (default: 3000)
VITE_PORT=3000

# Enable admin authentication (future feature)
# VITE_ADMIN_PASSWORD=your-secure-password

# Camera default settings
# VITE_DEFAULT_CAMERA_FACING=user
# VITE_CAPTURE_RESOLUTION_WIDTH=1920
# VITE_CAPTURE_RESOLUTION_HEIGHT=1080

# Photo capture settings
# VITE_PHOTOS_TO_CAPTURE=8
# VITE_COUNTDOWN_SECONDS=5
# VITE_PHOTOS_TO_SELECT=4
